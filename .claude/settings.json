{
  "permissions": {
    "allow": [
      "Bash(.agent-rules/merge.sh *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Read(**/.env*)",
      "Read(**/release.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.psk)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin HEAD:refs/heads/main)",
      "Bash(git push origin HEAD:refs/heads/main *)",
      "Bash(git push origin *:main)",
      "Bash(git push origin *:main *)",
      "Bash(git push origin *:refs/heads/main)",
      "Bash(git push origin *:refs/heads/main *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --force-with-lease=*)",
      "Bash(gh api *merge)",
      "Bash(gh api *merge *)",
      "Bash(gh api *merges*)",
      "Bash(gh api *mergePullRequest*)"
    ]
  }
}
