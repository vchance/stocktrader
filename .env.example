# Copy to .env (git-ignored) and fill in. Sources with missing keys are skipped.
# Plain KEY=value lines: no quotes, and no `$` or ` #` in values (Docker Compose would mangle them).

# Server operations (deploy/collector.sh health / housekeeping):
# Alerts are POSTed here as plain text with a Title header, e.g. an ntfy.sh topic (use a long random name;
# anyone who knows it can read it): https://ntfy.sh/stocktrader-<random>
# ALERT_WEBHOOK_URL=
# Nightly copy of data/ (any rsync destination: /mnt/backup/stocktrader or user@host:stocktrader-backup).
# A local destination must contain a .stocktrader-backup file (create it once), so an unmounted drive is
# caught instead of filling the root disk. Remote destinations need key-based ssh (no prompts).
# BACKUP_DEST=
# Optional dead-man's switch pinged by every hourly health check, e.g. a healthchecks.io check URL; it
# alerts you if the pings stop (host down, timers broken).
# HEARTBEAT_URL=

# Where a local (non-Docker) collector writes its archive; the container ignores this and uses /data/raw.
# STOCKTRADER_DATA_DIR=data/raw

# Alpaca (paper account is enough): https://app.alpaca.markets -> API keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# marketdata: price feed (sip = all US venues; iex if your plan rejects sip) and trading API for asset lists
# ALPACA_DATA_FEED=sip
# ALPACA_TRADING_URL=https://paper-api.alpaca.markets
# Paper trading (deploy/collector.sh paper-trade) runs every plan in plans/ with mode = "paper", each in its own
# Alpaca paper account (create one per plan in the Alpaca dashboard). Keys are named after the plan, in capitals
# with dashes as underscores; two plans may not share an account. For plans/quality-value-core.toml:
# APCA_API_KEY_ID_QUALITY_VALUE_CORE=
# APCA_API_SECRET_KEY_QUALITY_VALUE_CORE=
# Alternatively, one strategy in the account above, as `stocktrader paper` flags (paths are inside the container,
# e.g. --attention /data/signals/apewisdom.parquet). When set, plans are not paper-traded.
# PAPER_ARGS=--symbols AAPL,MSFT,NVDA --strategy sma --fast 20 --slow 50 --weight 0.05

# SEC EDGAR (fundamentals): the SEC requires a contact in every request's User-Agent, "Name email".
# SEC_USER_AGENT=Jane Doe jane@example.com

# Finnhub free tier: https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Reddit: https://www.reddit.com/prefs/apps -> create app, type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for "<platform>:<app id>:<version> (by /u/<your username>)"
# REDDIT_USER_AGENT=macos:stocktrader-collector:v0.1 (by /u/your_username)
# REDDIT_SUBREDDITS=wallstreetbets,stocks,investing
