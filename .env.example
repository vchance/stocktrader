# Copy to .env (git-ignored) and fill in. Sources with missing keys are skipped.
# Plain KEY=value lines: no quotes, and no `$` or ` #` in values (Docker Compose would mangle them).

# Where a local (non-Docker) collector writes its archive; the container ignores this and uses /data/raw.
# STOCKTRADER_DATA_DIR=data/raw

# Alpaca (paper account is enough): https://app.alpaca.markets -> API keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Finnhub free tier: https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Reddit: https://www.reddit.com/prefs/apps -> create app, type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for "<platform>:<app id>:<version> (by /u/<your username>)"
# REDDIT_USER_AGENT=macos:stocktrader-collector:v0.1 (by /u/your_username)
# REDDIT_SUBREDDITS=wallstreetbets,stocks,investing
